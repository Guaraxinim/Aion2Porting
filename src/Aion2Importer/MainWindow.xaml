<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Aion2Importer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/a2p-icon.ico" Title="Aion2 Porting" Width="1520" Height="940" MinWidth="1180" MinHeight="760" Background="#080C14" Foreground="#E5E7EB" FontSize="11" FontFamily="./Assets/#Plus Jakarta Sans" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Design.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0D111D" BorderBrush="#232D47" BorderThickness="0,0,0,1" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="↻ Atualizar catálogo" Click="Refresh_Click" />
          <Button Content="Abrir Exportação" Click="Outputs_Click" />
          <Button Content="Blender" Click="Blender_Click" />
          <Button Content="⚙ Opções" Click="Options_Click" Background="#00F2FE" Foreground="#080C14" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Rectangle Width="46" Height="30" Fill="{StaticResource BrandLogo}" Margin="0,0,12,0" />
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontSize="14" FontWeight="ExtraBold">
                <Run Text="Aion2 " />
                <Run Text="Porting" Foreground="#00F2FE" />
              </TextBlock>
              <Border Background="#163346" BorderBrush="#236575" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                <TextBlock x:Name="VersionLabel" FontSize="9" Foreground="#00F2FE" />
              </Border>
            </StackPanel>
            <TextBlock Text="Explore, selecione e leve seus assets para o Blender" Foreground="#67789E" FontSize="9" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LibraryColumn" Width="256" />
        <ColumnDefinition x:Name="LibraryGap" Width="0" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PreviewGap" Width="0" />
        <ColumnDefinition x:Name="PreviewColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="0" />
      </Grid.RowDefinitions>
      <Border x:Name="LibraryPanel" Grid.RowSpan="2" Background="#0D111D" BorderBrush="#232D47" BorderThickness="0,0,1,0" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="GERAL" Foreground="#67789E" FontSize="9" FontWeight="Bold" Margin="12,0,0,6" />
            <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="⌂    Início" Click="Home_Click" Foreground="#00F2FE" Background="#162C3D" />
            <DockPanel Margin="12,20,8,6">
              <TextBlock Text="EXPORTAR" FontWeight="Bold" Foreground="#67789E" FontSize="9" />
              <TextBlock x:Name="LibraryCount" Text="Sem catálogo" Foreground="#00F2FE" FontSize="9" HorizontalAlignment="Right" Visibility="Collapsed" />
            </DockPanel>
            <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Content="▣    Biblioteca total" Click="Library_Click" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Border BorderBrush="#232D47" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="4,12,4,0">
              <TextBlock x:Name="CatalogStamp" Text="Selecione o jogo nas opções." Foreground="#67789E" FontSize="9" TextWrapping="Wrap" />
            </Border>
            <Grid Background="#0D111D" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0">
                <TextBlock x:Name="StatusText" MouseLeftButtonUp="CopyStatus_Click" Cursor="Hand" Text="Pronto" Foreground="#67789E" TextTrimming="CharacterEllipsis" FontSize="9" TextWrapping="Wrap" MaxHeight="100" />
                <ProgressBar x:Name="Progress" Height="4" Foreground="#00F2FE" Background="#232D47" Margin="0,8,10,0" />
              </StackPanel>
              <Button x:Name="CancelButton" Grid.Column="1" Content="×" Foreground="#FF6262" Background="#391C26" ToolTip="Cancelar tarefa atual" Click="Cancel_Click" IsEnabled="False" Padding="0" Height="28" Width="28" FontSize="18" />
            </Grid>
          </StackPanel>
          <ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="FilterChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="10" />
                  <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="#67789E" FontSize="9" Margin="6,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="HomeView" Grid.Column="2" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3" Grid.RowSpan="2">
        <StackPanel Margin="24">
          <Border CornerRadius="16" BorderBrush="#232D47" BorderThickness="1" Padding="28">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#121726" />
                <GradientStop Color="#181F33" Offset=".6" />
                <GradientStop Color="#121726" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <Border Background="#173344" BorderBrush="#295C65" BorderThickness="1" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                <TextBlock x:Name="HomeVersionLabel" Foreground="#00F2FE" FontSize="10" FontWeight="Bold" />
              </Border>
              <DockPanel Margin="0,18,0,10">
                <Rectangle Width="112" Height="46" DockPanel.Dock="Left" Margin="0,0,16,0" Fill="{StaticResource BrandLogo}" />
                <TextBlock Text="Aion2 Porting" FontSize="28" FontWeight="ExtraBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="Explore, filtre e visualize os assets do Aion 2 antes de preparar sua importação no Blender." Foreground="#67789E" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Left" LineHeight="20" />
              <WrapPanel Margin="0,20,0,0">
                <Button x:Name="ExploreButton" Content="Explorar biblioteca" Click="Library_Click" Background="#00F2FE" Foreground="#080C14" FontWeight="Bold" />
                <Button Content="Configurar diretórios" Click="Options_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="HISTÓRICO DE ATUALIZAÇÕES" FontWeight="Bold" FontSize="13" Margin="0,28,0,6" />
          <TextBlock Text="Recursos implementados ao longo do projeto" Foreground="#67789E" Margin="0,0,0,16" />
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Identidade e interface local" FontSize="13" FontWeight="Bold" Foreground="#00F2FE" />
              <TextBlock Text="Aion2 Porting • layout baseado no HTML" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Logo transparente no cabeçalho e ícone de fundo branco no programa. Nome atualizado, navegação Início/Biblioteca, fonte Plus Jakarta Sans, paleta ciano e roxo e painel de opções. Cards com 60 assets por página, seleção múltipla e paginação; ícones neutros enquanto não há miniaturas reais." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Busca, filtros e organização" FontSize="13" FontWeight="Bold" Foreground="#C77DFF" />
              <TextBlock Text="Tipos combinados e exclusões" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Busca por palavras no caminho, nome exato, caminho exato, nome do asset e padrões * e ?. Filtros de categoria, subcategoria e chunk; vários tipos simultâneos; campo Excluir com trechos separados por ponto e vírgula; preferência pela versão base aos Type." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Viewer 3D integrado" FontSize="13" FontWeight="Bold" Foreground="#00F2FE" />
              <TextBlock Text="Geometria real antes da importação" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Prévia ao lado da biblioteca sem abrir o Blender. Girar, deslocar, zoom, enquadrar (F), frente e lado. Modo sólido ou textura base bruta. Seletor de malhas apenas para assets com várias malhas; adicionar à fila e fechar o painel sem perder filtros." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Modelos confirmados e cache" FontSize="13" FontWeight="Bold" Foreground="#C77DFF" />
              <TextBlock Text="Modelo disponível após prévia válida" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Confirmação persistente após carregar a geometria. Cache separado por instalação e mapping, invalidado quando os arquivos de origem mudam. Falhas não confirmam o asset. cache/previews é limpo ao fechar normalmente; confirmações e exports são preservados." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Fila, biblioteca e progresso" FontSize="13" FontWeight="Bold" Foreground="#00F2FE" />
              <TextBlock Text="Mais espaço para os assets" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Adicionar selecionados ou todos os resultados, impedir duplicatas, remover itens e acompanhar o estado de cada exportação. Ocultar/mostrar fila sem perder itens. Biblioteca recolhível, sem rolagem horizontal. Progresso abaixo da descrição e × vermelho para cancelar." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Exportação e Blender" FontSize="13" FontWeight="Bold" Foreground="#C77DFF" />
              <TextBlock Text="Saída configurável e organização simples" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Conversão em GLB e importação no Blender com validação da geometria, relatório e gravação em .blend. Uma pasta por asset, arquivos anteriores preservados e manutenção dos filtros após exportar. Jogo, Blender e pasta de saída configuráveis; instalação do jogo somente para leitura." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Importação de cabelos GM_Hair" FontSize="13" FontWeight="Bold" Foreground="#00F2FE" />
              <TextBlock Text="Seleção por número e variantes" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Lote específico de GM_Hair_N: prioriza o arquivo base; se não existir, seleciona as variantes Type. O relatório de 08/10 registra 103 arquivos importados e validados no Blender, incluindo a cópia de teste do 002 e o marcador 000." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Aplicativo e distribuição portátil" FontSize="13" FontWeight="Bold" Foreground="#C77DFF" />
              <TextBlock Text="EXE e dependências locais" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Distribuição portátil com runtime incluído, sem exigir Git ou SDK no destino. Abra Aion2Porting.exe e mantenha as pastas de suporte ao lado dele. A pasta distribuída não inclui exports ou caches pessoais." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Leitura dos assets e diagnóstico" FontSize="13" FontWeight="Bold" Foreground="#00F2FE" />
              <TextBlock Text="Aion 2 • perfil GAME_Aion2" FontSize="10" Foreground="#E5E7EB" Margin="0,6,0,0" />
              <TextBlock Text="Leitura dos índices do jogo, mapping .usmap e resolução dos pacotes atualizados. Catálogo de assets e chunks, inventário, exportação individual/em lote, logs e relatórios de falhas. Compatibilidade confirmada por testes de cada modelo, sem pressupor suporte a todos os assets." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
          <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="Limites atuais" FontWeight="Bold" Foreground="#C77DFF" />
              <TextBlock Text="Materiais aproximados são opcionais. Animações compatíveis podem ser visualizadas. Os programas de sombreamento originais, os efeitos completos e a física do jogo não são simulados. A preparação para FiveM é uma etapa posterior." TextWrapping="Wrap" Foreground="#67789E" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="LibraryView" Grid.Column="2" Visibility="Collapsed" Grid.RowSpan="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="QueueRow" Height="0" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#121726" BorderBrush="#232D47" BorderThickness="0,0,0,1" Padding="12">
          <StackPanel>
            <TextBlock Text="Biblioteca de assets" FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,6" />
            <TextBlock Text="Explore, filtre e selecione os assets para visualizar ou exportar." Foreground="#67789E" Margin="0,0,0,14" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="SearchMode" SelectionChanged="FilterChanged" Margin="0,0,8,0" />
              <TextBox x:Name="Query" Grid.Column="1" TextChanged="SearchChanged" ToolTip="Busca por nome ou caminho" />
              <Button Grid.Column="2" Content="Limpar" Click="Clear_Click" Margin="8,0,0,0" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="Sections" SelectionChanged="FilterChanged" Margin="0,0,8,0" />
              <Grid Grid.Column="1" Margin="0,0,8,0">
                <ToggleButton x:Name="TypesButton" Content="Todos os tipos ▾" />
                <Popup PlacementTarget="{Binding ElementName=TypesButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=TypesButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                  <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" Padding="8" CornerRadius="12">
                    <ListBox x:Name="Hints" SelectionMode="Multiple" SelectionChanged="TypesChanged" Background="#121726" BorderThickness="0" MinWidth="250" MaxHeight="350" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Content="{Binding}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" IsHitTestVisible="False" Focusable="False" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Grid>
              <ComboBox x:Name="Chunks" Grid.Column="2" SelectionChanged="FilterChanged" />
              <DockPanel Grid.Column="3" Margin="8,0,8,0">
                <TextBlock Text="Excluir:" VerticalAlignment="Center" Foreground="#67789E" Margin="0,0,6,0" />
                <TextBox x:Name="ExcludeQuery" TextChanged="SearchChanged" ToolTip="Separe trechos por ponto e vírgula" />
              </DockPanel>
              <CheckBox x:Name="PreferBase" Grid.Column="4" Content="Preferir base aos Type" Checked="ToggleChanged" Unchecked="ToggleChanged" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Caminho:" Foreground="#67789E" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="Folder" TextChanged="SearchChanged" ToolTip="Filtrar pelo início do caminho: AION2/Content/..." Margin="0" Grid.Column="1" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#0D111D" BorderBrush="#232D47" BorderThickness="0,0,0,1" Padding="12,8">
          <DockPanel LastChildFill="True">
            <Button x:Name="PreviewButton" Content="Visualizar" Background="#153845" Foreground="#00F2FE" BorderBrush="#28626A" Click="Preview_Click" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
            <WrapPanel>
              <Button x:Name="AddButton" Content="+ Adicionar selecionados" Background="#059669" Foreground="White" Click="Add_Click" />
              <Button x:Name="AddResultsButton" Content="Adicionar resultados" Click="AddResults_Click" />
              <Button Content="Copiar caminho" Click="Copy_Click" />
              <Button Content="Editar subcategoria" Click="EditSubcategory_Click" />
              <Button x:Name="LibraryToggle" Content="Ocultar biblioteca" Click="LibraryToggle_Click" />
            </WrapPanel>
          </DockPanel>
        </Border>
        <ListBox x:Name="AssetsGrid" Grid.Row="2" Margin="10" Background="#080C14" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AssetsSelectionChanged" MouseDoubleClick="Assets_DoubleClick">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Width" Value="158" />
              <Setter Property="Height" Value="204" />
              <Setter Property="Margin" Value="5" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="#181F33" BorderBrush="#232D47" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="#00F2FE" />
                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="#4FACFE" />
                        <Setter TargetName="Card" Property="Background" Value="#222B45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Path}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="5" />
                  <RowDefinition />
                  <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Border Background="#00F2FE" CornerRadius="12,12,0,0" />
                <Grid Grid.Row="1">
                  <Grid.Background>
                    <RadialGradientBrush>
                      <GradientStop Color="#222B45" />
                      <GradientStop Color="#0D111D" Offset="1" />
                    </RadialGradientBrush>
                  </Grid.Background>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Viewbox Width="42" Height="42" Margin="0,0,0,10">
                      <Viewbox.Style>
                        <Style TargetType="Viewbox">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AudioConfirmed}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTexture}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AnimationConfirmed}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Viewbox.Style>
                      <Path Stroke="#4FACFE" StrokeThickness="1.1" Data="M12,2 L2,7 12,12 22,7 Z M2,7 L2,17 12,22 22,17 22,7 M12,12 L12,22" />
                    </Viewbox>
                    <Grid Tag="AnimationIcon" Width="54" Height="54" Margin="0,0,0,8" HorizontalAlignment="Center" ToolTip="Animação">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AnimationConfirmed}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Border CornerRadius="17" Background="#154FACFE" BorderBrush="#554FACFE" BorderThickness="1" />
                      <Viewbox Width="32" Height="32">
                        <Canvas Width="32" Height="32">
                          <Path Stroke="#4FACFE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M16,9 L16,19 M9,12 L23,12 M9,12 L5,18 M23,12 L27,8 M16,19 L11,24 8,29 M16,19 L21,24 25,28" />
                          <Ellipse Width="7" Height="7" Canvas.Left="12.5" Canvas.Top="1" Stroke="#4FACFE" StrokeThickness="2" />
                          <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="17" Fill="#4FACFE" />
                          <Ellipse Width="3.5" Height="3.5" Canvas.Left="7.25" Canvas.Top="10.25" Fill="#4FACFE" />
                          <Ellipse Width="3.5" Height="3.5" Canvas.Left="21.25" Canvas.Top="10.25" Fill="#4FACFE" />
                          <Ellipse Width="3.5" Height="3.5" Canvas.Left="9.25" Canvas.Top="22.25" Fill="#4FACFE" />
                          <Ellipse Width="3.5" Height="3.5" Canvas.Left="19.25" Canvas.Top="22.25" Fill="#4FACFE" />
                        </Canvas>
                      </Viewbox>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding MontageConfirmed}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="+" Foreground="#4FACFE" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <Grid Tag="AudioIcon" Width="54" Height="54" Margin="0,0,0,8" HorizontalAlignment="Center" ToolTip="Áudio confirmado">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AudioConfirmed}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Border CornerRadius="17" Background="#154FACFE" BorderBrush="#554FACFE" BorderThickness="1" />
                      <Viewbox Width="34" Height="30">
                        <Path Stroke="#4FACFE" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,12 L 3,20 M 10,6 L 10,26 M 17,2 L 17,30 M 24,8 L 24,24 M 31,13 L 31,19" />
                      </Viewbox>
                    </Grid>
                    <Grid Tag="TextureIcon" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="Textura disponível">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTexture}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Border Background="#154FACFE" BorderBrush="#554FACFE" BorderThickness="1" CornerRadius="12" />
                      <Viewbox Width="29" Height="29">
                        <Path Stroke="#4FACFE" StrokeThickness="1.5" Data="M2,2 L22,2 22,22 2,22 Z M3,19 L9,12 14,17 18,13 22,18 M7,6 L10,6 10,9 7,9 Z" />
                      </Viewbox>
                    </Grid>
                    <TextBlock Text="PRÉVIA SOB DEMANDA" Foreground="#67789E" FontSize="7" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Image Grid.Row="1" Source="{Binding Thumbnail}" Stretch="Uniform" IsHitTestVisible="False" Margin="2" />
                <StackPanel Grid.Row="2" Margin="9,8">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Hint}" FontSize="8" Foreground="#67789E" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" FontSize="8" Foreground="#67789E" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="16,0,12,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="PrevPage" Content="‹" Click="PrevPage_Click" />
            <TextBlock x:Name="PageText" ToolTip="60 assets por página. Adicionar resultados inclui toda a busca." VerticalAlignment="Center" Foreground="#67789E" Margin="4,0,10,0" />
            <Button x:Name="NextPage" Content="›" Click="NextPage_Click" />
            <Button x:Name="QueueToggle" Content="Mostrar fila" Click="QueueToggle_Click" />
          </StackPanel>
          <TextBlock x:Name="ResultCount" Foreground="#67789E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Border x:Name="QueuePanel" Grid.Row="4" Background="#121726" BorderBrush="#232D47" BorderThickness="0,1,0,0" Padding="12" Visibility="Collapsed">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RemoveButton" Content="Remover" Click="Remove_Click" />
                <Button Content="Abrir resultado" Click="OpenResult_Click" />
              </StackPanel>
              <TextBlock x:Name="QueueTitle" Text="FILA DE EXPORTAÇÃO" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="QueueGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Detalhes" Binding="{Binding Error}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <Border Grid.Row="5" Background="#121726" BorderBrush="#232D47" BorderThickness="0,1,0,0" Padding="12">
          <DockPanel>
            <Button x:Name="RunButton" DockPanel.Dock="Right" Content="↓  Exportar para Blender" Background="{StaticResource Accent}" Foreground="#080C14" FontWeight="ExtraBold" Click="Run_Click" Margin="10,0,0,0" />
            <TextBlock x:Name="Details" Text="Selecione um asset para inspecionar." Foreground="#67789E" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </DockPanel>
        </Border>
      </Grid>
      <Border x:Name="InspectorEmpty" Grid.Column="4" Background="#121726" BorderBrush="#232D47" BorderThickness="1,0,0,0" Padding="16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="INSPEÇÃO DO ASSET" Foreground="#00F2FE" FontWeight="Bold" FontSize="10" />
          <TextBlock Text="Selecione um asset" FontWeight="Bold" Margin="0,8,0,20" />
          <Border Background="#080C14" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Height="256">
            <StackPanel VerticalAlignment="Center">
              <Viewbox Height="50" Margin="0,0,0,18">
                <Path Stroke="#232D47" StrokeThickness="1" Data="M12,2 L2,7 12,12 22,7 Z M2,7 L2,17 12,22 22,17 22,7 M12,12 L12,22" />
              </Viewbox>
              <TextBlock Text="Visualizar 3D para carregar" Foreground="#67789E" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="A prévia utiliza a geometria real do asset. Nenhum modelo é carregado automaticamente." Foreground="#67789E" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="18" />
        </StackPanel>
      </Border>
      <ContentControl x:Name="PreviewHost" Grid.Column="4" Visibility="Collapsed" />
      <Grid x:Name="OptionsOverlay" Grid.ColumnSpan="5" Grid.RowSpan="2" Background="#D9080A12" Visibility="Collapsed">
        <Border Background="#121726" BorderBrush="#232D47" BorderThickness="1" CornerRadius="16" Width="570" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <DockPanel Margin="0,0,0,22">
              <Button DockPanel.Dock="Right" Content="×" Click="OptionsClose_Click" />
              <TextBlock Text="☷  Opções de configuração" Foreground="#00F2FE" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Caminho do jogo (AION 2)" Margin="0,0,0,8" />
            <DockPanel>
              <Button x:Name="GameButton" DockPanel.Dock="Right" Content="Procurar" Click="OptionsGameBrowse_Click" Margin="8,0,0,0" />
              <TextBox x:Name="GamePath" />
            </DockPanel>
            <TextBlock Text="Executável do Blender" Margin="0,18,0,8" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Procurar" Click="OptionsBlenderBrowse_Click" Margin="8,0,0,0" />
              <TextBox x:Name="BlenderPath" />
            </DockPanel>
            <TextBlock Text="Pasta de saída das exportações" Margin="0,18,0,8" />
            <DockPanel>
              <Button x:Name="OutputButton" DockPanel.Dock="Right" Content="Procurar" Click="OptionsOutputBrowse_Click" Margin="8,0,0,0" />
              <TextBox x:Name="OutputPath" />
            </DockPanel>
            <TextBlock Text="Idioma" Margin="0,18,0,8" />
            <ComboBox x:Name="LanguageChoice" SelectedIndex="0">
              <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)" />
              <ComboBoxItem Tag="en" Content="English" />
            </ComboBox>
            <TextBlock x:Name="OptionsError" Foreground="#FF7C8C" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button Content="Verificar tipos de todos os arquivos / Retomar" Click="Scan_Click" Margin="0,18,0,0" ToolTip="Valida cada asset, salva resultados e pula os itens já processados. O botão X interrompe a verificação." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
              <Button Content="Cancelar" Click="OptionsClose_Click" />
              <Button Content="Salvar alterações" Click="OptionsSave_Click" Background="#00F2FE" Foreground="#080C14" FontWeight="Bold" Margin="4,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
