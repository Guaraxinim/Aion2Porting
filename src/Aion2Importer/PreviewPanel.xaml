<UserControl x:Class="Aion2Importer.PreviewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#121627" Foreground="#E9EFF9" FontFamily="Segoe UI" Focusable="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Design.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="12" Background="#121627">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Fechar 3D" Click="Back_Click"/><StackPanel><TextBlock Text="PRÉVIA 3D" Foreground="#00F2FE" FontWeight="Bold"/><DockPanel><Button DockPanel.Dock="Right" Content="ⓘ" ToolTip="Inspecionar asset" Click="Inspect_Click"/><TextBlock x:Name="AssetTitle" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></DockPanel></StackPanel></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,12">
   <ComboBox x:Name="Models" Margin="0,0,0,8" DisplayMemberPath="Name" SelectionChanged="ModelChanged" Visibility="Collapsed"/>
   <UniformGrid Rows="1" Columns="3"><Button Content="Enquadrar" ToolTip="Enquadrar (F)" Click="Fit_Click" Padding="8,9"/><Button Content="Frente" Click="Front_Click" Padding="8,9"/><Button Content="Lado" Click="Side_Click" Padding="8,9" Margin="0"/></UniformGrid>
   <Button x:Name="AdvancedMaterials" Content="Ativar materiais avançados" ToolTip="Materiais aproximados; shaders originais não reproduzidos." Click="AdvancedMaterials_Click" Margin="0,8,0,0"/>
   <CheckBox x:Name="Textures" Content="Textura base (bruta)" Foreground="#C3D2E7" IsChecked="False" Margin="0,10,0,0" Checked="TextureChanged" Unchecked="TextureChanged"/>
  </StackPanel>
  <Border Grid.Row="2" Background="#080A12" CornerRadius="16" ClipToBounds="True">
   <Grid x:Name="Surface" Background="Transparent" MouseDown="PointerDown" MouseMove="PointerMove" MouseUp="PointerUp" MouseWheel="Wheel" SizeChanged="SurfaceSizeChanged">
    <Viewport3D x:Name="Viewport" IsHitTestVisible="False">
     <Viewport3D.Camera><PerspectiveCamera x:Name="Camera" FieldOfView="45" Position="0,0,3" LookDirection="0,0,-3" UpDirection="0,1,0"/></Viewport3D.Camera>
     <ModelVisual3D><ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#888888"/><DirectionalLight Color="#FFFFFF" Direction="-1,-1,-2"/><DirectionalLight Color="#A0BDCC" Direction="1,0,1"/></Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
     <ModelVisual3D x:Name="ObjectVisual"/>
    </Viewport3D>
    <Border x:Name="Loading" Background="#DD172333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"><TextBlock x:Name="LoadingText" Text="Carregando geometria…" Foreground="White" TextWrapping="Wrap" MaxWidth="550"/></Border>
    <TextBlock Text="Arraste: girar  •  Botão direito: mover  •  Roda: zoom" Foreground="#8A94B8" TextWrapping="Wrap" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" IsHitTestVisible="False"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,12,0,12" Background="#181D33"><TextBlock x:Name="Stats" TextWrapping="Wrap" Foreground="#00F2FE"/><TextBlock x:Name="Notice" Text="Pose de referência • Cor base opaca • Shaders e transparência do jogo não reproduzidos" Foreground="#8A94B8" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <StackPanel Grid.Row="4"><Button x:Name="AddQueue" DockPanel.Dock="Right" Content="Adicionar à fila" Background="#059669" Click="Add_Click" IsEnabled="False"/><TextBlock Text="Visualizar não inicia a importação no Blender." Foreground="#8A94B8" VerticalAlignment="Center"/></StackPanel>
 </Grid>
</UserControl>
